# Copy to .env for local development.
DATABASE_URL=postgres://hakiki:hakiki@localhost:5432/hakiki
BIND_ADDR=127.0.0.1:8080
RUST_LOG=hakiki_api=debug,tower_http=debug,info

# Publishable demo key seeded on startup so the marketing-site live demo works.
# This key is attached to the demo organization.
# Real partner keys should be issued out-of-band.
HAKIKI_DEMO_API_KEY=demo-public-key

# Rate limit (per API key, per minute)
HAKIKI_RATE_LIMIT_PER_MINUTE=120

# For dashboard demo login use seeded member email like demo@hakiki.test
# Token from /dashboard/auth/login used as X-Dashboard-Token header for protected dashboard routes.

# NOTE: All data sources (telco, nida, brela, tra) are currently SANDBOX/MOCK adapters.
# No real government or operator integrations are performed.

# Multi-tenant: all data is scoped to organizations.
# Demo org + member are auto-seeded on startup.
