# Copy to .env for local development.
DATABASE_URL=postgres://hakiki:hakiki@localhost:5432/hakiki
BIND_ADDR=127.0.0.1:8080
RUST_LOG=hakiki_api=debug,tower_http=debug,info

# Publishable demo key seeded on startup so the marketing-site live demo works.
# This key is treated as environment=test.
# Real partner keys should be issued out-of-band.
HAKIKI_DEMO_API_KEY=demo-public-key

# NOTE: All data sources (telco, nida, brela, tra) are currently SANDBOX/MOCK adapters.
# No real government or operator integrations are performed.
